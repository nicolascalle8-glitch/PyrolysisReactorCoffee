# Entornos virtuales de Python
.venv/
venv/
ENV/
env/

# Archivos compilados y caché de Python
__pycache__/
*.py[cod]
*$py.class

# Archivos de MATLAB
*.asv
*.m~
*.slxc
slprj/

# Sistema y logs
*.log
.DS_Store
Thumbs.db

# Configuración local de IDEs que no debe subirse
.idea/
*.suo
*.user

# Caché de pruebas
.pytest_cache/

# Configuración local de VS Code (la ruta del intérprete cambia entre Windows y Mac)
.vscode/

# Figuras que generan los scripts al correr (se regeneran; solo se suben las del documento)
*.png
!docs/figuras/*.png
